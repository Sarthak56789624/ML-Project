# CardioCare Configuration
PROJECT_NAME="CardioCare — Hypertension Risk Predictor"
VERSION=1.0.0
API_V1_STR=/api/v1

# Security & CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:8000","*"]
RATE_LIMIT_DEFAULT=120/minute

# Optional API Key for write protection (leave blank for open access)
API_KEY=

# Database
DATABASE_URL=sqlite+aiosqlite:///./cardiocare.db

# Vite Frontend API Base URL
VITE_API_BASE_URL=/api/v1
